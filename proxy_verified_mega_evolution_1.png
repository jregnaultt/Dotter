  document.querySelectorAll('[data-copy-code-button]').forEach((button) => {
    const label = button.querySelector('[data-copy-code-label]');
    const defaultLabel = label?.textContent ?? 'Copy';

    button.addEventListener('click', async () => {
      const card = button.closest('[data-copy-code-card]');
      const code = card?.querySelector('code')?.textContent ?? '';

      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }

      window.setTimeout(() => {
        if (label) label.textContent = defaultLabel;
      }, 1600);
    });
  });

  document.querySelectorAll('[data-faq-accordion]').forEach((accordion) => {
    const items = Array.from(accordion.querySelectorAll('[data-faq-item]'));

    function setFaqItemOpen(item, open) {
      const trigger = item.querySelector('[data-faq-trigger]');
      const panel = item.querySelector('[data-faq-panel]');
      const icon = item.querySelector('[data-faq-icon]');

      if (!trigger || !panel) return;

      trigger.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      panel.setAttribute('data-open', String(open));
      panel.style.maxHeight = open ? `${panel.scrollHeight}px` : '0px';
      icon?.classList.toggle('rotate-180', open);
    }

    items.forEach((item) => {
      const trigger = item.querySelector('[data-faq-trigger]');

      trigger?.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        items.forEach((otherItem) => {
          if (otherItem !== item) setFaqItemOpen(otherItem, false);
        });

        setFaqItemOpen(item, !isOpen);
      });
    });

    window.addEventListener('resize', () => {
      items.forEach((item) => {
        const trigger = item.querySelector('[data-faq-trigger]');
        if (trigger?.getAttribute('aria-expanded') === 'true') {
          setFaqItemOpen(item, true);
        }
      });
    });
  });
