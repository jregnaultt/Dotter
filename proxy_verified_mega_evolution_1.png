<span class="line"><span style="color:#9ECBFF">  '&#x26;ttl=900'</span><span style="color:#F97583"> +</span><span style="color:#6A737D"> // Cache for 15 minutes (seconds)</span></span>
<span class="line"><span style="color:#9ECBFF">  '&#x26;url=https%3A%2F%2Fapi.coinmarketcap.com%2Fdata-api%2Fv3%2Fcryptocurrency%2Fdetail%3Fslug%3Dbitcoin'</span><span style="color:#E1E4E8">;</span></span>
