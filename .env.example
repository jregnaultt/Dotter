# Configuración de variables de entorno para el generador de sprites

# API Key de Groq (Obtén tu clave en https://console.groq.com)
GROQ_API_KEY=tu_groq_api_key_aqui

# API Key y Modelo de Pollinations.ai (opcional)
POLLINATIONS_API_KEY=tu_pollinations_api_key_aqui
POLLINATIONS_MODEL=flux

# Directorio de salida
OUTPUT_DIR=output_sprites
